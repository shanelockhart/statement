{
  "name": "Statement Analyst",
  "short_name": "Analyst",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090d16",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "audio", "accept": ["audio/*", ".m4a", ".mp3", ".wav"] },
        { "name": "transcript", "accept": ["text/plain", ".txt"] }
      ]
    }
  }
}
